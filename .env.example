# Shared environment configuration for apps/api and apps/worker.
# Copy this file to .env and adjust values for local development.
# See packages/config/src/env.ts for the validated schema.

NODE_ENV=development

# PostgreSQL connection string.
# Matches the credentials in docker-compose.yml for local development.
DATABASE_URL=postgresql://patchwork:patchwork@localhost:5433/patchwork

# Port the API server listens on.
API_PORT=3001

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- apps/api-only config (see apps/api/src/config.ts) ---
# See docs/github-integration.md for exact manual setup steps.

# The GitHub App's numeric App ID (Settings -> Developer settings -> your App).
GITHUB_APP_ID=

# The GitHub App's URL slug, e.g. "patchwork-dev" for github.com/apps/patchwork-dev
GITHUB_APP_SLUG=

# OAuth client ID/secret, from the App's "General" settings page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The App's private key (.pem), base64-encoded onto a single line:
#   base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_PRIVATE_KEY_BASE64=

# Optional. Shares the session cookie across subdomains in production, e.g.
# ".patchwork.dev" so both app.patchwork.dev and api.patchwork.dev can read
# it. Leave unset for local development (host-only cookie works across
# localhost ports automatically).
SESSION_COOKIE_DOMAIN=

# The web app's origin -- apps/api redirects the browser here after
# completing GitHub OAuth/installation callbacks.
WEB_APP_URL=http://localhost:3000

# --- apps/web-only config ---

# Where apps/web reaches apps/api for server-side requests. Server-only,
# never exposed to browser JS (see apps/web/src/lib/api.ts).
API_URL=http://localhost:3001

# Optional. Enables the "Explain impact" / "Explain uncertainty" action on an
# assessment. Everything else in Patchwork -- analysis, impact assessment,
# remediation, verification, pull requests -- works without it; when it is
# absent that one endpoint reports itself unavailable and nothing else changes.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini. Part of the explanation cache key, so
# changing it regenerates rather than reusing copy from a different model.
OPENAI_EXPLANATION_MODEL=gpt-4o-mini
